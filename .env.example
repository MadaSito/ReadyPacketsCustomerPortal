# ReadyPackets server environment reference (DATA ONLY).
# See server/config/env.example for the complete canonical template.
# Native: /etc/readypackets/portal.env. Docker: see deploy/docker/README.md.

# Absolute FFmpeg executable path; does not enable conversion.
RP_FFMPEG_PATH=/usr/bin/ffmpeg
# Optional absolute path of a locally installed country database; unset by default.
PROTECTION_MMDB_PATH=
# Emergency application Protection bypass; does not bypass authorization.
PROTECTION_DISABLED=0
# Optional literal x-readypackets-country; only for a custom trusted direct proxy that overwrites client values.
PROTECTION_COUNTRY_HEADER=
