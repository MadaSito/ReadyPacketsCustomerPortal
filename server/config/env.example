# ReadyPackets portal — environment template (DATA ONLY: never `source` this file or run it as a script).
# Copy to a root-owned file such as /etc/readypackets/portal.env (0600 root:root) consumed by
# systemd `EnvironmentFile=`; prefer `<NAME>_FILE` for every secret (0600/0640, owned by root or the service
# user, not group/other-writable, not other-readable, ≤ 64 KiB). Setting both NAME and NAME_FILE is refused.
# There are NO default secrets. Generate keys with:  tsx scripts/ops/keys/generate.ts
# Check a configuration (reports variable names + rules only, never values):  tsx scripts/ops/keys/doctor.ts
# Optional providers (SMTP, SIEM, SAML, analytics, …) are configured in the admin console, not here.

# --- runtime -----------------------------------------------------------------
# production | development | test
NODE_ENV=
# production | development | test | preview (defaults from NODE_ENV; preview = sandboxed demo only, refused on readypackets.com)
RP_DEPLOYMENT_PROFILE=
# Only with RP_DEPLOYMENT_PROFILE=preview: must be exactly synthetic-data-only
RP_PREVIEW_ACKNOWLEDGED=
# web | worker | all (default all)
RP_ROLE=
# Listen address (default 127.0.0.1 — keep loopback behind Nginx)
HOST=
# Listen port (default 5000)
PORT=
# debug | info | warn | error (default info; debug is discouraged in production)
RP_LOG_LEVEL=
# Service name for logs/SIEM (default portal)
RP_SERVICE_NAME=
# Release reference reported in health/audit, [A-Za-z0-9._+-]{1,80}
RP_RELEASE_REF=
# Directory holding the release's Drizzle migrations (default ./migrations)
RP_MIGRATIONS_DIR=

# --- optional media and Protection -------------------------------------------
# Absolute path to packaged FFmpeg (default /usr/bin/ffmpeg). Setting this does not enable conversion.
RP_FFMPEG_PATH=
# Absolute path of an operator-supplied country MMDB (e.g. /var/lib/readypackets/geo/country.mmdb).
PROTECTION_MMDB_PATH=
# 0 (default) or 1 (emergency bypass of Protection rules; does not change authentication/authorization).
PROTECTION_DISABLED=
# No default. Only set if your trusted direct proxy removes incoming copies and overwrites with its own country code.
PROTECTION_COUNTRY_HEADER=

# --- origins -----------------------------------------------------------------
# REQUIRED. Single canonical origin, no path/trailing slash; https required in production. e.g. https://my.readypackets.com
RP_CANONICAL_ORIGIN=
# Comma-separated alias hostnames that redirect to the canonical origin, e.g. portal.readypackets.com
RP_ALIAS_HOSTS=
# Public marketing site origin for outbound links (default https://www.readypackets.com)
RP_MARKETING_ORIGIN=
# Comma-separated EXACT numeric IPs/CIDRs of trusted reverse proxies (empty = trust none), e.g. 127.0.0.1
RP_TRUSTED_PROXIES=

# --- data --------------------------------------------------------------------
# REQUIRED secret. mysql:// URL for a least-privilege application account (production: password ≥ 16 chars, not a default)
DATABASE_URL=
# DATABASE_URL_FILE=
# Connection pool size 1-64 (default 10)
RP_DB_POOL_SIZE=
# REQUIRED. Absolute path of private object storage, outside any web root
RP_STORAGE_DIR=
# REQUIRED. Stable installation identifier, [a-z0-9-] 3-63 chars
RP_INSTALLATION_ID=

# --- keys (all REQUIRED unless noted; every key must be distinct) -------------
# Field-encryption keyring JSON: {"current":"<id>","keys":{"<id>":"<base64 32 bytes>", "<retired-id>": "…"}}
RP_DATA_KEYRING=
# RP_DATA_KEYRING_FILE=
# Blind-index HMAC key (base64, 32 bytes). NEVER replace casually — see scripts/ops/keys/RUNBOOK.md
RP_INDEX_KEY=
# RP_INDEX_KEY_FILE=
# OPTIONAL. Previous blind-index key, only during a blind-index transition
RP_INDEX_KEY_PREVIOUS=
# RP_INDEX_KEY_PREVIOUS_FILE=
# Audit/SIEM pseudonym HMAC key
RP_PSEUDONYM_KEY=
# RP_PSEUDONYM_KEY_FILE=
# HMAC key for stored single-use token hashes
RP_TOKEN_HASH_KEY=
# RP_TOKEN_HASH_KEY_FILE=
# Audit tamper-evidence chain key
RP_AUDIT_CHAIN_KEY=
# RP_AUDIT_CHAIN_KEY_FILE=

# --- backup (read and validated by the backup module) ------------------------
# OPTIONAL secret. Backup encryption keyring JSON or 32-byte key; prefer RP_BACKUP_KEY_FILE (0600)
RP_BACKUP_KEY=
# RP_BACKUP_KEY_FILE=
# OPTIONAL. Key id used for new backup archives
RP_BACKUP_KEY_ID=
# OPTIONAL. Absolute path of the private restore-verification sandbox
RP_RECOVERY_SANDBOX_DIR=
