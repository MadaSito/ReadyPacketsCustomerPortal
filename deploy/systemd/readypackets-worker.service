[Unit]
Description=ReadyPackets fenced background worker
Documentation=https://my.readypackets.com
After=network-online.target mysql.service
Wants=network-online.target
StartLimitIntervalSec=120s
StartLimitBurst=4

[Service]
Type=simple
# Install with readypackets-runtime.conf as the 10-runtime.conf drop-in.
Environment=RP_ROLE=worker
LoadCredential=database_url:/etc/readypackets/secrets/database_url
Environment=DATABASE_URL_FILE=%d/database_url
ExecStart=/usr/local/bin/node /opt/readypackets/current/dist/server/main.js
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=78

[Install]
WantedBy=multi-user.target
