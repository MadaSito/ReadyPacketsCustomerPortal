# ReadyPackets portal — edge proxy for the Docker Compose stack.
# Mirrors the forwarding contract of deploy/nginx/readypackets-portal.conf: one hop, forwarding headers
# overwritten (never appended), client tracing headers removed, request bodies capped per route.
# Known difference: this proxy applies no edge request-rate or connection limits; the application's own
# limits still apply.
#
# RP_DOMAIN         the portal host name (for example my.example.com)
# RP_TLS_DIRECTIVE  "" or "tls <email>" for a public certificate, "tls internal" for a self-signed one
{
	admin off
	persist_config off
	skip_install_trust
	servers {
		protocols h1 h2
		timeouts {
			read_header 20s
			idle 30s
		}
	}
}

(rp_upstream) {
	reverse_proxy web:5000 {
		header_up Host {$RP_DOMAIN}
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Port 443
		header_up -Forwarded
		header_up -traceparent
		header_up -tracestate
		flush_interval -1
		transport http {
			dial_timeout 5s
			response_header_timeout 120s
		}
	}
}

{$RP_DOMAIN} {
	{$RP_TLS_DIRECTIVE}

	# No access log: request paths and query strings are never written by the proxy. The application
	# logs safe route templates with a request id.
	header {
		-Server
		-Via
	}

	@portable_import path /api/portable/imports
	handle @portable_import {
		request_body {
			max_size 192MiB
		}
		import rp_upstream
	}

	@file_upload path /api/files/upload/*
	handle @file_upload {
		request_body {
			max_size 256MiB
		}
		import rp_upstream
	}

	@presentation_image path /api/platform/presentation/images
	handle @presentation_image {
		request_body {
			max_size 2MiB
		}
		import rp_upstream
	}

	handle {
		request_body {
			max_size 256KiB
		}
		import rp_upstream
	}
}

# Any other host name on port 80 is refused. Requests for RP_DOMAIN are redirected to HTTPS by Caddy's
# automatic redirect, which takes precedence over this catch-all. On port 443 an unknown name has no
# certificate, so the TLS handshake fails.
http:// {
	respond 421
}
