# ReadyPackets portal — edge proxy for the Docker Compose stack.
# Mirrors the forwarding contract of deploy/nginx/readypackets-portal.conf: one hop, forwarding headers
# overwritten (never appended), client tracing headers removed, request bodies capped per route.
# Known difference: this proxy applies no edge request-rate or connection limits; the application's own
# limits still apply.
#
# RP_DOMAIN         the portal host name (for example my.example.com)
# RP_TLS_DIRECTIVE  "" or "tls <email>" for a public certificate, "tls internal" for a self-signed one
{
	admin off
	persist_config off
	skip_install_trust
	# The proxy writes no access log. Its error log (for example "upstream unreachable") would otherwise
	# include the request target and headers, so both are removed before anything is written.
	log {
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
			}
		}
	}
	servers {
		protocols h1 h2
		# The Host header must match the name in the TLS handshake.
		strict_sni_host on
		timeouts {
			read_header 20s
			# Whole-request budgets (Caddy has no per-read idle timer for clients). The application
			# closes any request it has not fully received within 120 seconds.
			read_body 130s
			write 30m
			idle 30s
		}
	}
}

(rp_upstream) {
	reverse_proxy web:5000 {
		header_up Host {$RP_DOMAIN}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Host {$RP_DOMAIN}
		header_up X-Forwarded-Port 443
		header_up -Forwarded
		header_up -X-ReadyPackets-Country
		header_up -traceparent
		header_up -tracestate
		transport http {
			dial_timeout 5s
			# Starts once the request has been sent in full. Per-read upstream timers are not used:
			# they also count the time a client spends uploading and would cut long uploads short.
			response_header_timeout 120s
		}
	}
}

{$RP_DOMAIN} {
	{$RP_TLS_DIRECTIVE}

	# No access log here. The application logs safe route templates with a request id.
	header {
		-Server
		-Via
	}

	# A Host header carrying any port other than 443 is refused, as the Nginx profile does.
	@other_port {
		header_regexp Host :[0-9]*$
		not header_regexp Host :443$
	}
	handle @other_port {
		respond 421
	}

	# Case-sensitive, anchored matches: only the exact upload routes get a larger body allowance.
	@portable_import path_regexp ^/api/portable/imports$
	handle @portable_import {
		request_body {
			max_size 192MiB
		}
		import rp_upstream
	}

	@file_upload path_regexp ^/api/files/upload/
	handle @file_upload {
		request_body {
			max_size 256MiB
		}
		import rp_upstream
	}

	@presentation_image path_regexp ^/api/platform/presentation/images$
	handle @presentation_image {
		request_body {
			max_size 2MiB
		}
		import rp_upstream
	}

	handle {
		request_body {
			max_size 256KiB
		}
		import rp_upstream
	}
}

# Plain HTTP for RP_DOMAIN redirects to HTTPS except sensitive callbacks, which are refused with 404
# and no Location header so callback queries are never echoed into a redirect. Caddy's built-in ACME
# HTTP-01 solver still intercepts /.well-known/acme-challenge/* ahead of these handlers.
http://{$RP_DOMAIN} {
	header {
		-Server
		-Via
	}

	@other_http_port {
		header_regexp Host :[0-9]*$
		not header_regexp Host :80$
	}
	handle @other_http_port {
		respond 421
	}

	@canonical_callback path_regexp (?i)^/(?:api/identity/sso/callback/?$|api/storage/oauth/callback(?:/|$)|api/(?:webhooks/inbound|payments/(?:webhooks|return))(?:/|$))
	handle @canonical_callback {
		respond 404
	}

	handle {
		redir https://{$RP_DOMAIN}{uri} 308
	}
}

# Any other host name on port 80 is refused. On port 443 an unknown name has no certificate, so the TLS
# handshake fails.
http:// {
	respond 421
}
