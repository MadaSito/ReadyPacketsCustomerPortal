# Applies to builds that use deploy/docker/Dockerfile with the repository root as context.
.git
.github
node_modules
dist
coverage
docs
**/*.log
**/.env
**/.env.*
!**/.env.example
**/.DS_Store
**/*.tsbuildinfo
.vite
/var
/tmp
# Only the two files the image needs come from deploy/. Everything else there (and any stray secret
# file left in the checkout) stays out of the build context and the build cache.
deploy/**
!deploy/docker/init-secrets.sh
!deploy/docker/healthcheck.mjs
**/*.pem
**/*.key
**/*.pw
**/*.secret
**/*.rpbk
