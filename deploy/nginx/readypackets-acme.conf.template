#@ TEMPLATE (see readypackets-portal.conf.template).
# Temporary HTTP-only vhost, used before issuance. Remove once the full site is enabled.
server_tokens off;
# Any other name, and requests by IP address, are dropped without an answer.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name @RP_SERVER_NAMES@;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/readypackets-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location / { return 404; }
}
