#@ TEMPLATE. Rendered by deploy/lib.sh (render_site) from /etc/readypackets/site.conf; never enable this file as is.
#@ @RP_HOST@ is the portal's host name and @RP_ALIAS@ an optional second name that only redirects to it. Lines
#@ between "#@alias{" and "#@alias}" are dropped when no alias is configured; lines starting "#@ " are never copied.
# ReadyPackets portal site for @RP_HOST@. Generated by the deployment kit; rerun it instead of editing this file.
# Included in nginx http{} via sites-enabled. Dedicated nginx host, no other default vhosts.
# Nothing here sets a plain directive at http level: the distribution's nginx.conf already sets some of them
# (server_tokens, ssl_protocols, access_log), a second copy is a configuration error on Ubuntu 26.04, and a
# second access_log would be added to the stock one instead of replacing it. Every server block below
# includes snippets/readypackets-edge.conf, which carries those settings at server level.

limit_req_zone $binary_remote_addr zone=rp_edge:10m rate=25r/s;
limit_conn_zone $binary_remote_addr zone=rp_conns:10m;
# The installer uses IPv4 loopback for Nginx health checks while public traffic is fenced.
map $remote_addr $rp_maintenance_file {
    default /etc/nginx/readypackets-maintenance;
    127.0.0.1 "";
}
# Exact names only (map string keys are compared case-insensitively), with or without the default port.
map $http_host $rp_http_authority_ok {
    default 0;
    @RP_HOST@ 1;
    @RP_HOST@:80 1;
#@alias{
    @RP_ALIAS@ 1;
    @RP_ALIAS@:80 1;
#@alias}
}
#@alias{
map $http_host $rp_portal_authority_ok {
    default 0;
    @RP_ALIAS@ 1;
    @RP_ALIAS@:443 1;
}
#@alias}
map $http_host $rp_my_authority_ok {
    default 0;
    @RP_HOST@ 1;
    @RP_HOST@:443 1;
}
# Never log request paths/queries, Referer, cookies, or credentials. The app logs safe route templates.
# The format is only defined here; snippets/readypackets-edge.conf selects it for every server block.
log_format rp_json escape=json '{"time":"$time_iso8601","edge_request_id":"$request_id","request_id":"$upstream_http_x_request_id","method":"$request_method","status":$status,"bytes":$body_bytes_sent,"duration_s":$request_time}';
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    include /etc/nginx/snippets/readypackets-edge.conf;
    return 444;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    include /etc/nginx/snippets/readypackets-edge.conf;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name @RP_SERVER_NAMES@;
    include /etc/nginx/snippets/readypackets-edge.conf;
    if ($rp_http_authority_ok = 0) { return 444; }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/readypackets-acme;
        default_type text/plain;
        try_files $uri =404;
    }
    # Sensitive callbacks are canonical HTTPS only; never put their queries in a redirect.
    location ~* ^/(?:api/identity/sso/callback/?$|api/storage/oauth/callback(?:/|$)|api/(?:webhooks/inbound|payments/(?:webhooks|return))(?:/|$)) {
        return 404;
    }
    location / {
        return 308 https://@RP_HOST@$request_uri;
    }
}
#@alias{
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @RP_ALIAS@;
    include /etc/nginx/snippets/readypackets-edge.conf;
    if ($rp_portal_authority_ok = 0) { return 444; }
    include /etc/nginx/snippets/readypackets-tls.conf;
    # No app response here. Canonical vhost passes the application's own HSTS unchanged.
    add_header Strict-Transport-Security "max-age=31536000" always;
    # Sensitive callbacks are canonical HTTPS only; never put their queries in a redirect.
    location ~* ^/(?:api/identity/sso/callback/?$|api/storage/oauth/callback(?:/|$)|api/(?:webhooks/inbound|payments/(?:webhooks|return))(?:/|$)) {
        return 404;
    }
    location / {
        return 308 https://@RP_HOST@$request_uri;
    }
}
#@alias}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name @RP_HOST@;
    include /etc/nginx/snippets/readypackets-edge.conf;
    if ($rp_my_authority_ok = 0) { return 444; }
    include /etc/nginx/snippets/readypackets-tls.conf;

    # Root-managed sentinel persists through reboot until an operator proves the release healthy.
    if (-f $rp_maintenance_file) { return 503; }

    client_header_timeout 20s;
    client_body_timeout 30s;
    client_max_body_size 256k;
    send_timeout 60s;
    keepalive_timeout 30s;
    limit_req zone=rp_edge burst=100 nodelay;
    limit_req_status 429;
    limit_conn rp_conns 20;
    limit_conn_status 429;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host @RP_HOST@;
    # Single hop. Overwrite, never append client-supplied forwarding or tracing headers.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host @RP_HOST@;
    proxy_set_header X-Forwarded-Port 443;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_set_header traceparent "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    # No nginx asset cache or Expires override. App publishes immutable hashed assets and revalidates
    # index.html/sw.js (authenticated responses are no-store). Never serve the private storage tree.

    location = /api/portable/imports {
        client_max_body_size 192m;
        proxy_pass http://127.0.0.1:5000;
    }
    location ^~ /api/files/upload/ {
        client_max_body_size 256m;
        proxy_pass http://127.0.0.1:5000;
    }
    location = /api/platform/presentation/images {
        client_max_body_size 2m;
        proxy_pass http://127.0.0.1:5000;
    }
    location / {
        proxy_pass http://127.0.0.1:5000;
    }
}
